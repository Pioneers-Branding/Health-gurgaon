# HealthGurgaon environment variables. Copy to .env (gitignored) and fill in.
# Only variables prefixed NEXT_PUBLIC_ ever reach the browser.

# ── Database ────────────────────────────────────────────────────────────────
# SQLite in development: the path is relative to prisma/schema.prisma (→ prisma/dev.db).
# PostgreSQL in production: change `provider` in prisma/schema.prisma to "postgresql" and use
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/healthgurgaon?schema=public"
DATABASE_URL="file:./dev.db"

# ── Auth ────────────────────────────────────────────────────────────────────
# Secret used to HMAC one-time codes and to hash IP addresses for rate limits.
# At least 32 random bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it invalidates codes that are in flight (sessions are unaffected).
AUTH_SECRET=""

# Comma-separated phone numbers that are made admin when they sign in.
# Any common format works (+91 90000 00001, 9000000001); they are normalised to +91XXXXXXXXXX.
# Removing a number does not demote an existing admin: change roles from /admin.
ADMIN_PHONES="+919000000001"

# ── One-time codes (OTP) ────────────────────────────────────────────────────
# Which sender delivers sign-in codes. Implemented: "dev".
#   dev  Logs the code on the server. Outside production it is also shown on the sign-in screen
#        ("Development mode: your code is 123456"). In production the dev sender refuses to run
#        unless OTP_DEV_ALLOW_IN_PRODUCTION=1 (staging only: codes end up in server logs).
# To add MSG91, Twilio or WhatsApp, see docs/BACKEND.md → "Plugging in a real SMS/WhatsApp sender".
OTP_PROVIDER="dev"
# OTP_DEV_ALLOW_IN_PRODUCTION="0"

# Optional limits (defaults shown).
# OTP_MAX_PER_PHONE_PER_HOUR="5"
# OTP_MAX_PER_IP_PER_HOUR="20"

# Examples for real senders (not implemented yet; names are the ones docs/BACKEND.md uses):
# MSG91_AUTH_KEY=""
# MSG91_TEMPLATE_ID=""
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM=""
# WHATSAPP_TOKEN=""
# WHATSAPP_PHONE_NUMBER_ID=""
# WHATSAPP_OTP_TEMPLATE=""

# ── Email ───────────────────────────────────────────────────────────────────
# Which sender delivers emails (the link that confirms an address for messages). Implemented: "dev",
# which logs the email on the server and, outside production, shows the link on screen.
EMAIL_PROVIDER="dev"

# ── Site ────────────────────────────────────────────────────────────────────
# Absolute origin used for canonical URLs, hreflang alternates, share links and email links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
