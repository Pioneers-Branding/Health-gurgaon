// HealthGurgaon data model.
//
// Portability: development runs on SQLite; production can run on PostgreSQL by changing only
// `provider` and DATABASE_URL below (then `npm run db:push`). Everything here is supported by
// both connectors:
//   * Closed vocabularies are Prisma enums (SQLite stores them as TEXT, PostgreSQL as enum types).
//   * Lists and small structured values are Json (SQLite has no scalar lists). Their TypeScript
//     shapes live in src/lib/json-types.ts and are always read through the helpers there.
//   * Ids are generated by Prisma (cuid / nanoid), never by the database.
// Rows imported from the clickable prototype carry `sample = true`.
//
// See docs/BACKEND.md for the model overview, cache tags and how pages read this data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  resident
  champion
  provider
  rwa
  moderator
  editor
  admin
}

enum ProviderKind {
  doctor
  clinic
  hospital
  lab
  pharmacy
  blood_bank
  ambulance
  emergency_dept
  home_care
}

enum Ownership {
  private
  government
  charitable
  ppp
}

enum ListingStatus {
  pending // suggested or submitted, not yet verified: never shown publicly
  published
  hidden
  closed // closed permanently: kept for history, never shown in results
  merged // duplicate merged into another listing
}

enum VerificationResult {
  verified // checked against a primary source
  stated // stated by the provider, not independently checked
  unverified // not yet verified
  failed // checked and found wrong
}

enum ReviewStatus {
  pending
  published
  needs_changes
  rejected
  withdrawn
}

enum ReportType {
  fact // a fact is wrong: goes to the editor queue
  complaint // a concern about care or conduct: confidential path, never published
  missing // something is missing (a provider or a locality)
}

enum ReportStatus {
  received
  checking
  resolved // corrected
  no_change // checked, information was right
  rejected
}

enum DisputeTarget {
  ranking
  mention
  review
}

enum DisputeRole {
  provider
  resident
  other
}

enum DisputeReason {
  different
  fake
  conflict
  outdated
  method
  other
}

enum DisputeStatus {
  received
  under_review
  upheld
  partly_upheld
  not_upheld
  withdrawn
}

enum ClaimRole {
  doctor
  staff
  administrator
}

enum ClaimStatus {
  pending
  approved
  rejected
  info_requested
  escalated
}

enum EventType {
  health_camp
  screening
  blood_drive
  vaccination
  workshop
  talk
  senior_activity
  other
}

enum EventStatus {
  awaiting_review
  changes_requested // sent back to the submitter; not public
  verified
  rejected
  cancelled
  completed
}

enum OrganiserType {
  rwa
  resident_group
  ngo
  hospital_clinic
  other
}

enum ArticleLabel {
  reporting
  roundup
  opinion
  sponsored
}

enum ContentStatus {
  draft
  published
  archived
}

enum CorrectionKind {
  corrected
  verified
  merged
  updated
}

enum ThreadStatus {
  pending // first-time posters wait for a moderator
  open
  resolved
  hidden
  removed
}

enum PostStatus {
  pending
  published
  hidden
  removed
}

enum FlagStatus {
  open
  resolved
  dismissed
}

enum SocietyType {
  registered_rwa
  apartment_association
  informal_group
}

enum SocietyStatus {
  pending
  verified
  rejected
}

enum ContactChannel {
  whatsapp
  phone
  email
}

enum VolunteerPay {
  voluntary
  stipend
  reimbursed
  paid_per_piece
}

enum VolunteerAudience {
  resident
  student
  professional
}

enum ApplicationStatus {
  received
  call_scheduled
  accepted
  declined
  withdrawn
}

enum MentionSentiment {
  strong_positive
  mild_positive
  negative
  question // asked about the doctor: never counted
  conflict // staff, relatives, self-promotion: excluded
  allegation // held for a moderator, never scored
}

enum MentionTrust {
  verified_visit // 1.5×
  established // 1×
  new_account // 0.3× (account under 30 days)
}

enum StoryStatus {
  pending
  published
  withdrawn
}

enum SavedKind {
  provider
  event
  article
  guide
  thread
  top_list
  story
}

enum FollowKind {
  locality
  topic
  thread
  society
  provider
}

enum AlertPref {
  none
  in_app
  email
  whatsapp
}

/// The five message types on the account's "WhatsApp & email" page (wording: src/lib/consent-text.ts).
enum ConsentPurpose {
  weekly_report // Weekly Gurgaon Health Report
  city_channel // Gurugram camps & public-health alerts
  locality_updates // Locality alerts
  community_replies // Replies to my questions
  saved_changes // Changes to things I saved
}

enum ConsentChannel {
  whatsapp
  email
  sms
}

/// One line of the consent record. granted/withdrawn/channel_changed concern a message type;
/// setting (language, email) and sign_in_only (the number, for codes only) concern the account.
enum ConsentAction {
  granted // "AGREED"
  withdrawn // "STOPPED"
  channel_changed // "CHANGED": same message type, now by WhatsApp or email
  setting // "SETTING"
  sign_in_only // "SIGN-IN ONLY"
}

// ─────────────────────────────────────────────────────────────────────────────
// Places and taxonomies
// ─────────────────────────────────────────────────────────────────────────────

/// A canonical Gurugram locality. The list itself is code-owned (src/lib/localities.ts) and
/// copied here by the seed so other tables can reference it.
model Locality {
  slug           String    @id
  name           String
  nameHi         String?
  covers         String
  aliases        Json // string[]
  sectors        Json // [from, to][]
  mapX           Int // position on the 520×440 schematic map
  mapY           Int
  live           Boolean   @default(false) // page published (enough verified listings) and indexable
  description    String?
  gettingCare    String?
  editorLabel    String?
  stats          Json // LocalityStats snapshot (see json-types.ts)
  statsCheckedAt DateTime?
  pageUpdatedAt  DateTime?
  sortOrder      Int       @default(0)
  sample         Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  providers      Provider[]
  events         Event[]
  threads        Thread[]
  societies      Society[]
  featured       FeaturedProvider[]
  mentions       NeighbourMention[]
  topListEntries TopListEntry[]
  users          User[]
}

model Specialty {
  slug              String    @id
  name              String // "Paediatrics"
  nameHi            String?
  doctorNoun        String // "Paediatrician"
  doctorNounPlural  String // "Paediatricians"
  summary           String? // reviewed explainer
  whenToSee         String?
  emergencyNote     String?
  synonyms          Json // string[]: what residents type ("child doctor")
  conditions        Json // string[]: condition phrases that map here ("child fever")
  relatedSearches   Json // string[]: broader searches offered on no results
  faqs              Json // Faq[]
  relatedGuideSlugs Json // string[]
  reviewedBy        String?
  reviewedAt        DateTime?
  sortOrder         Int       @default(0)
  sample            Boolean   @default(false)

  providers Provider[]
  mentions  NeighbourMention[]
}

model FacilityType {
  slug        String  @id
  name        String
  description String?
  inDirectory Boolean @default(true) // shown on /gurgaon/facilities
  sortOrder   Int     @default(0)

  providers Provider[]
}

// ─────────────────────────────────────────────────────────────────────────────
// Providers
// ─────────────────────────────────────────────────────────────────────────────

model Provider {
  id                  String        @id @default(cuid())
  slug                String        @unique
  kind                ProviderKind
  name                String
  initials            String
  headline            String // "Paediatrician · MBBS, MD"
  specialtySlug       String?
  qualifications      String?
  registrationCouncil String?
  registrationNumber  String?
  yearsInPractice     Int?
  gender              String? // "female" | "male", only when stated; powers the female-doctor filter
  ownership           Ownership     @default(private)
  facilityTypeSlug    String?
  sizeLabel           String? // "200+ beds"
  bedCount            Int?
  addressLine         String?
  areaLabel           String? // "Sushant Lok 1 clinic", "Sector 56 market"
  sector              String? // "Sector 51"
  localitySlug        String?
  servesLocalities    Json // string[]: other localities this provider serves
  distanceKm          Float? // from the centre of its locality (shown on cards)
  languages           Json // string[]
  consultationFee     Int? // ₹; 0 = free; null = unknown
  feeVerified         Boolean       @default(false)
  followUpTerms       String?
  openingHours        Json? // OpeningHours
  open24h             Boolean       @default(false)
  hoursSummary        String? // "Open 7 am – 8 pm"
  hoursSource         String?
  hoursCheckedAt      DateTime?
  practiceLabel       String? // where the timings apply: "Little Steps Clinic, Sushant Lok 1"
  wheelchairAccess    Boolean? // verified step-free access; null = not verified
  accessibility       Json // AccessibilityItem[]
  services            Json // string[]
  tags                Json // string[]
  keywords            String        @default("")
  keyFact             String? // short card line: "Home sample collection"
  departments         Json // Department[]
  emergency           Json? // EmergencyInfo
  homeVisits          Boolean       @default(false)
  homeCollection      Json? // HomeCollection
  delivery            Boolean       @default(false)
  tests               Json // LabTest[]
  visitingInfo        Json? // VisitingInfo
  publicPhone         String? // business number, revealed on click only
  badges              Json // string[]: "Registration checked", ...
  sponsored           Boolean       @default(false)
  sponsorLabel        String?
  claimed             Boolean       @default(false)
  status              ListingStatus @default(published)
  reviewStats         Json? // ReviewStats snapshot
  lastCheckedAt       DateTime?
  nextCheckAt         DateTime?
  sample              Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  specialty    Specialty?    @relation(fields: [specialtySlug], references: [slug])
  facilityType FacilityType? @relation(fields: [facilityTypeSlug], references: [slug])
  locality     Locality?     @relation(fields: [localitySlug], references: [slug])

  practicesAt    ProviderAffiliation[] @relation("DoctorAffiliations")
  doctorsHere    ProviderAffiliation[] @relation("FacilityAffiliations")
  verifications  VerificationRecord[]
  reviews        Review[]
  claims         Claim[]
  disputes       Dispute[]
  questions      ProviderQuestion[]
  threads        Thread[]
  mentions       NeighbourMention[]
  topListEntries TopListEntry[]
  stories        Story[]
  featured       FeaturedProvider[]
  corrections    Correction[]
  changes        ListingChange[]

  @@index([kind])
  @@index([localitySlug])
  @@index([specialtySlug])
  @@index([status])
  @@index([facilityTypeSlug])
  @@index([lastCheckedAt])
}

/// Doctor ↔ facility, with the days the doctor is there.
model ProviderAffiliation {
  id         String  @id @default(cuid())
  doctorId   String
  facilityId String
  days       String? // "Tue, Thu"
  department String?
  verified   Boolean @default(false)
  source     String?
  sortOrder  Int     @default(0)

  doctor   Provider @relation("DoctorAffiliations", fields: [doctorId], references: [id], onDelete: Cascade)
  facility Provider @relation("FacilityAffiliations", fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([doctorId, facilityId])
  @@index([facilityId])
}

/// One checked fact: what, how, result, source and when. Shown on the profile's
/// facts grid (showAsFact) and/or the verification record tab (showInLog).
model VerificationRecord {
  id          String             @id @default(cuid())
  providerId  String
  field       String // registration | qualifications | fee | languages | affiliations | accessibility | address | hours | emergency | licence | accreditation | facility | next_check
  label       String // "Medical council registration"
  value       String?
  method      String? // "Matched name and number on the Haryana Medical Council register"
  result      VerificationResult
  note        String? // short public note: "✓ Matched on council register, 12 Oct 2026"
  showAsFact  Boolean            @default(false)
  showInLog   Boolean            @default(true)
  checkedAt   DateTime?
  checkedById String?
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

/// "Featured hospitals serving <locality>": editor-chosen, never ranked.
model FeaturedProvider {
  id           String  @id @default(cuid())
  localitySlug String
  providerId   String
  placement    String // "homepage" | "locality"
  sortOrder    Int     @default(0)
  metaLine     String // "4.0 km · Sector 51 · 200+ beds"
  highlights   Json // string[]: "Paediatrics", "Cardiology"
  photoLabel   String?

  locality Locality @relation(fields: [localitySlug], references: [slug], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([localitySlug, providerId, placement])
}

/// "Ask the hospital": factual questions with the provider's official answer.
model ProviderQuestion {
  id         String    @id @default(cuid())
  providerId String
  question   String
  answer     String?
  answeredAt DateTime?
  published  Boolean   @default(true)
  sample     Boolean   @default(false)
  createdAt  DateTime  @default(now())

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Reviews, reports, disputes, claims
// ─────────────────────────────────────────────────────────────────────────────

model Review {
  id               String       @id @default(cuid())
  ref              String       @unique // "HG-RV-8830"
  providerId       String
  authorId         String?
  authorLabel      String // public and anonymised: "Parent · Sushant Lok"
  visitMonth       String // as chosen: "September 2026"
  visitType        String?
  department       String?
  answers          Json // Record<questionKey, answer>
  text             String // already redacted
  redactions       Json // Redaction[]
  noConflict       Boolean
  verificationTags Json // string[]: "Visit confirmed by clinic"
  status           ReviewStatus @default(pending)
  autoChecks       Json // AutoCheck[]
  flags            Json // string[]
  privateNote      String? // moderator-only context
  moderationReason String? // shown to the author when returned (needs_changes) or rejected
  suggestion       String? // optional rewording a moderator offers the author; never public
  editText         String? // an edit of a published review waiting for a moderator; text stays live until approved
  editSubmittedAt  DateTime?
  moderatedById    String?
  moderatedAt      DateTime?
  providerReply    String?
  providerReplyAt  DateTime?
  helpfulCount     Int          @default(0)
  publishedAt      DateTime?
  sample           Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  provider Provider        @relation(fields: [providerId], references: [id], onDelete: Cascade)
  author   User?           @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  helpful  ReviewHelpful[]

  @@index([providerId, status])
  @@index([status, createdAt])
  @@index([authorId])
}

model ReviewHelpful {
  reviewId  String
  userId    String
  createdAt DateTime @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reviewId, userId])
}

model Report {
  id            String       @id @default(cuid())
  ref           String       @unique // "HG-2041"
  type          ReportType
  targetKind    String? // provider | event | article | guide | thread | post | review | locality | story | page
  targetId      String?
  targetLabel   String // what the reporter typed or the item title
  field         String? // Timings | Address | Phone | Fee | Services | Accessibility | Closed | Duplicate
  details       String
  firsthand     Boolean      @default(false)
  isAllegation  Boolean      @default(false) // allegations take the confidential path
  evidenceNote  String?
  reporterId    String?
  reporterEmail String? // private, only to send status updates
  status        ReportStatus @default(received)
  timeline      Json // TimelineEntry[]
  resolution    String?
  resolvedAt    DateTime?
  resolvedById  String?
  autoChecks    Json
  flags         Json
  privateNote   String?
  sample        Boolean      @default(false)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  reporter User? @relation("ReportAuthor", fields: [reporterId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([targetKind, targetId])
  @@index([reporterId])
}

model Dispute {
  id                 String        @id @default(cuid())
  ref                String        @unique // "HG-DS-0419"
  target             DisputeTarget
  providerId         String?
  topListSlug        String?
  itemLabel          String // "Top hospitals by patient experience, Gurugram 2026 · #2"
  filerRole          DisputeRole
  filerConnection    String?
  filerId            String?
  reason             DisputeReason
  details            String
  links              Json // string[]
  evidenceFiles      Json // EvidenceFile[] (names and sizes only)
  email              String? // private: only to send the outcome
  declared           Boolean
  status             DisputeStatus @default(received)
  outcomeText        String? // the published one-line reason
  outcomePublishedAt DateTime?
  decidedById        String?
  sample             Boolean       @default(false)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  provider Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  filer    User?     @relation("DisputeFiler", fields: [filerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([providerId])
  @@index([outcomePublishedAt])
}

model Claim {
  id                 String      @id @default(cuid())
  ref                String      @unique // "HG-CL-0311"
  providerId         String
  claimantId         String?
  claimantRole       ClaimRole
  registrationNumber String?
  otpVerified        Boolean     @default(false)
  authorisationNote  String?
  status             ClaimStatus @default(pending)
  autoChecks         Json
  flags              Json
  privateNote        String?
  decisionReason     String?
  decidedById        String?
  decidedAt          DateTime?
  sample             Boolean     @default(false)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  claimant User?    @relation("ClaimAuthor", fields: [claimantId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([providerId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Events
// ─────────────────────────────────────────────────────────────────────────────

model Event {
  id                String        @id @default(cuid())
  slug              String        @unique
  ref               String?       @unique // "HG-EV-5182" for submitted events
  title             String
  type              EventType
  template          String?
  description       String?
  bring             String?
  organiserName     String
  organiserType     OrganiserType
  organiserVerified Boolean       @default(false)
  organiserNote     String? // "Verified society · with an eye hospital's community outreach team (sample)"
  societyId         String?
  startsAt          DateTime
  endsAt            DateTime?
  timeLabel         String // "9 am–1 pm"
  venue             String?
  localitySlug      String?
  isOnline          Boolean       @default(false)
  eligibility       String?
  audience          Json // string[]: "Senior citizens"
  cost              String // "Free" | "₹200"
  isFree            Boolean       @default(true)
  registration      String?
  capacity          Int?
  services          Json // string[]
  status            EventStatus   @default(awaiting_review)
  source            String? // how it was verified, or "Resident submission"
  verifiedAt        DateTime?
  verifiedById      String?
  submitterId       String?
  submittedAt       DateTime?
  contactName       String? // private
  contactRole       String? // private
  contactPhone      String? // private, never shown publicly
  consents          Json // string[]: wording the organiser agreed to
  autoChecks        Json
  flags             Json
  reportSummary     String? // after the event: counts only, no personal data
  requestedChanges  String? // status changes_requested: what the submitter must add or fix
  timeline          Json? // TimelineEntry[]: the submitter's progress view (received, organiser check, ...)
  sample            Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  locality    Locality?    @relation(fields: [localitySlug], references: [slug])
  society     Society?     @relation(fields: [societyId], references: [id], onDelete: SetNull)
  submitter   User?        @relation("EventSubmitter", fields: [submitterId], references: [id], onDelete: SetNull)
  corrections Correction[]

  @@index([status, startsAt])
  @@index([localitySlug])
  @@index([startsAt])
  @@index([societyId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Health Report (news), corrections, guides
// ─────────────────────────────────────────────────────────────────────────────

model Article {
  id          String        @id @default(cuid())
  slug        String        @unique
  label       ArticleLabel
  category    String // "PUBLIC HEALTH"
  title       String
  dek         String
  body        Json // string[] paragraphs
  sourceNote  String
  authorName  String?
  sponsorName String?
  status      ContentStatus @default(published)
  publishedAt DateTime
  sample      Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  corrections Correction[]

  @@index([status, publishedAt])
  @@index([label])
}

/// The public corrections log: articles, listings and events.
model Correction {
  id         String         @id @default(cuid())
  kind       CorrectionKind
  text       String
  happenedAt DateTime
  articleId  String?
  providerId String?
  eventId    String?
  sample     Boolean        @default(false)
  createdAt  DateTime       @default(now())

  article  Article?  @relation(fields: [articleId], references: [id], onDelete: SetNull)
  provider Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  event    Event?    @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([happenedAt])
}

/// A change to a listing's facts, as residents see it: "Sunday hours are now 7 am – 1 pm. They
/// were 7 – 11 am." Drives "Changed since you saved it", locality alerts and the weekly report.
model ListingChange {
  id         String   @id @default(cuid())
  providerId String
  field      String // hours | fee | address | phone | services | accessibility | status
  summary    String // the resident-facing sentence, before → after
  source     String? // who confirmed it: "the lab manager, by phone"
  reportRef  String? // the resident report that led to it ("HG-1987")
  changedAt  DateTime
  sample     Boolean  @default(false)
  createdAt  DateTime @default(now())

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, changedAt])
  @@index([changedAt])
}

model Guide {
  id                    String        @id @default(cuid())
  slug                  String        @unique
  title                 String
  category              String // breadcrumb: "Navigating care"
  tag                   String // card kicker: "GUIDE · NON-EMERGENCY CARE"
  summary               String?
  reviewedBy            String? // "Dr. P. Sharma, MD (General Medicine)"
  reviewNote            String? // card line: "Reviewed by a general physician"
  writtenBy             String?
  contentUpdatedAt      DateTime
  nextReviewAt          DateTime?
  sections              Json // GuideSection[]
  emergencyNote         String?
  localNote             Json? // LocalNote
  disclaimer            String?
  relatedSpecialtySlugs Json
  relatedGuideSlugs     Json
  status                ContentStatus @default(published)
  sortOrder             Int           @default(0)
  sample                Boolean       @default(false)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Community
// ─────────────────────────────────────────────────────────────────────────────

model Thread {
  id             String       @id @default(nanoid(10))
  title          String
  body           String?
  topicSlug      String
  localitySlug   String?
  areaLabel      String? // "Sector 65": shown as "a resident of Sector 65"
  authorId       String?
  authorLabel    String
  anonymous      Boolean      @default(true)
  status         ThreadStatus @default(pending)
  resolvedAt     DateTime?
  providerId     String? // a discussion about one provider
  replyCount     Int          @default(0)
  helpfulCount   Int          @default(0)
  answeredBy     String? // "Pharmacist" | "Hospital": set when a verified professional or the provider answers
  lastActivityAt DateTime     @default(now())
  autoChecks     Json
  flags          Json
  sample         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  locality Locality?          @relation(fields: [localitySlug], references: [slug])
  author   User?              @relation("ThreadAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  provider Provider?          @relation(fields: [providerId], references: [id], onDelete: SetNull)
  posts    Post[]
  mentions NeighbourMention[]

  @@index([status, lastActivityAt])
  @@index([topicSlug])
  @@index([localitySlug])
  @@index([providerId])
}

model Post {
  id                String     @id @default(cuid())
  threadId          String
  authorId          String?
  authorLabel       String // "Resident, Sector 62"
  professionalLabel String? // "Verified pharmacist": only for verified professionals
  isProviderAnswer  Boolean    @default(false) // an official answer from a claimed provider
  body              String // already redacted
  redactions        Json
  helpfulCount      Int        @default(0)
  isBest            Boolean    @default(false) // marked most helpful by the asker
  status            PostStatus @default(published)
  autoChecks        Json
  flags             Json
  sample            Boolean    @default(false)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  thread    Thread             @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User?              @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  reactions PostReaction[]
  mentions  NeighbourMention[]

  @@index([threadId, status])
  @@index([authorId])
}

model PostReaction {
  postId    String
  userId    String
  kind      String   @default("helpful")
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId, kind])
}

/// A post, thread, review or story reported by a resident (the community moderation queue).
model ContentFlag {
  id             String     @id @default(cuid())
  ref            String     @unique // "HG-CM-1904"
  targetKind     String // post | thread | review | story
  targetId       String
  targetLabel    String
  excerpt        String?
  reason         String
  reporterId     String?
  status         FlagStatus @default(open)
  autoChecks     Json
  flags          Json
  privateNote    String?
  decisionReason String?
  resolvedById   String?
  resolvedAt     DateTime?
  sample         Boolean    @default(false)
  createdAt      DateTime   @default(now())

  @@index([status, createdAt])
  @@index([targetKind, targetId])
}

/// Neighbour Recommendation System: one classified forum mention of a provider.
/// The score is computed from these rows by src/lib/ranking.ts.
model NeighbourMention {
  id             String           @id @default(cuid())
  providerId     String
  residentKey    String // stable, opaque id of the resident (one vote per resident per provider)
  userId         String?
  threadId       String?
  postId         String?
  localitySlug   String?
  specialtySlug  String?
  sentiment      MentionSentiment
  trust          MentionTrust
  mentionedAt    DateTime
  themes         Json // string[]: "Explains clearly"
  quote          String? // public snippet, health details stripped
  quoteMeta      String? // "SECTOR 49 · SEP 2026"
  counted        Boolean          @default(true)
  excludedReason String? // conflict_of_interest | question | allegation_held | misattributed | dispute_upheld | duplicate
  moderatedById  String?
  sample         Boolean          @default(false)
  createdAt      DateTime         @default(now())

  provider  Provider   @relation(fields: [providerId], references: [id], onDelete: Cascade)
  locality  Locality?  @relation(fields: [localitySlug], references: [slug])
  specialty Specialty? @relation(fields: [specialtySlug], references: [slug])
  thread    Thread?    @relation(fields: [threadId], references: [id], onDelete: SetNull)
  post      Post?      @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([providerId, counted])
  @@index([localitySlug, specialtySlug])
}

// ─────────────────────────────────────────────────────────────────────────────
// Healthy Neighbourhoods (RWAs) and volunteers
// ─────────────────────────────────────────────────────────────────────────────

model Society {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String
  shortName       String
  badgeText       String // "57"
  localitySlug    String?
  areaLabel       String? // "Sector 57, Gurugram"
  groupType       SocietyType
  status          SocietyStatus   @default(pending)
  verifiedAt      DateTime?
  memberSince     DateTime?
  contactName     String? // private
  contactRole     String? // private
  contactChannel  ContactChannel?
  contactPhone    String? // private
  contactEmail    String? // private
  localResources  String?
  profileViews30d Int             @default(0)
  registeredById  String?
  ref             String?         @unique
  sample          Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  locality        Locality?        @relation(fields: [localitySlug], references: [slug])
  members         SocietyMember[]
  initiatives     Initiative[]
  events          Event[]
  volunteerNeeds  VolunteerNeed[]
  volunteerOffers VolunteerOffer[]

  @@index([status])
}

model SocietyMember {
  id         String   @id @default(cuid())
  societyId  String
  userId     String?
  name       String // "R. Kapoor"
  title      String // "Secretary"
  permission String // admin | editor | viewer
  createdAt  DateTime @default(now())

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([societyId])
  @@index([userId])
}

/// A completed activity report on a society profile (counts only, never attendee data).
model Initiative {
  id        String   @id @default(cuid())
  societyId String
  title     String
  heldOn    DateTime
  summary   String
  eventId   String?
  published Boolean  @default(true)
  sample    Boolean  @default(false)
  createdAt DateTime @default(now())

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)

  @@index([societyId])
}

model VolunteerNeed {
  id        String   @id @default(cuid())
  societyId String
  title     String
  detail    String
  open      Boolean  @default(true)
  createdAt DateTime @default(now())

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
}

/// A volunteer's offer to help one society (shown on the private dashboard).
model VolunteerOffer {
  id          String    @id @default(cuid())
  societyId   String
  userId      String?
  displayName String // first name + stated skill only
  detail      String
  status      String    @default("pending") // pending | accepted | declined
  decidedAt   DateTime?
  createdAt   DateTime  @default(now())

  society Society @relation(fields: [societyId], references: [id], onDelete: Cascade)
}

model VolunteerRole {
  slug                 String            @id
  title                String
  description          String
  timeCommitment       String // "3–4 HRS / MONTH"
  pay                  VolunteerPay
  payLabel             String // "Voluntary"
  audience             VolunteerAudience
  access               String
  requiresRegistration Boolean           @default(false)
  sortOrder            Int               @default(0)

  applications VolunteerApplication[]
}

model VolunteerApplication {
  id                 String            @id @default(cuid())
  ref                String            @unique // "HG-VOL-412"
  roleSlug           String
  userId             String?
  name               String
  localityText       String
  skills             String?
  availability       Json // string[]
  registrationNumber String?
  consent            Boolean
  status             ApplicationStatus @default(received)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  role VolunteerRole @relation(fields: [roleSlug], references: [slug])
  user User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Top lists and patient stories
// ─────────────────────────────────────────────────────────────────────────────

model TopList {
  slug            String     @id
  title           String // hub card: "Top paediatricians in Gurugram"
  h1              String // "Top 10 paediatricians in Gurugram, 2026"
  crumb           String
  tabLabel        String
  hubGroup        String // filter chip: Doctors | Hospitals | Care centres | Diagnostics | Government
  bandGroup       String // card band: DOCTORS | HOSPITALS | CARE CENTRES | DIAGNOSTICS | GOVERNMENT
  countLabel      String // "10"
  intro           String
  basis           String // "BASED ON 1,284 VERIFIED REVIEWS"
  hubMeta         String // "1,284 reviews · registration verified"
  badgeLabel      String // badge on every entry
  sourceListSlug  String? // a filtered view of another list ("government" → "hospitals")
  presetOwnership Ownership?
  published       Boolean    @default(true)
  listUpdatedAt   DateTime
  sortOrder       Int        @default(0)
  sample          Boolean    @default(false)

  entries TopListEntry[]
}

model TopListEntry {
  id           String    @id @default(cuid())
  listSlug     String
  providerId   String?
  name         String
  ownership    Ownership
  typeLabel    String
  meta         String
  quote        String
  score        Int // 0–100, see ranking.ts topListScore()
  reviewCount  Int
  subScores    Json // [patientExperience, waitAccess, informationQuality, valueTransparency]
  localitySlug String?
  hasStory     Boolean   @default(false)
  movement     String // "▲ 1 since Sep" | "NEW" | "—"
  sortOrder    Int       @default(0)
  sample       Boolean   @default(false)

  list     TopList   @relation(fields: [listSlug], references: [slug], onDelete: Cascade)
  provider Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  locality Locality? @relation(fields: [localitySlug], references: [slug])

  @@index([listSlug])
  @@index([providerId])
}

/// A consented, visit-confirmed patient video or written story.
model Story {
  id             String      @id @default(cuid())
  slug           String      @unique
  ref            String?     @unique
  title          String
  whoLabel       String // "Son of a patient, Sector 49"
  providerId     String?
  providerName   String
  ownership      Ownership
  category       String // Recovery | Children | Seniors | Women’s health | Chronic care
  durationLabel  String // "3:12"
  meta           String // "TRANSITION CARE · OCT 2026"
  transcript     String
  format         String      @default("video") // video | written
  consented      Boolean     @default(false)
  visitConfirmed Boolean     @default(false)
  privacyEdited  Boolean     @default(false)
  notPaid        Boolean     @default(false)
  status         StoryStatus @default(pending)
  videoUrl       String?
  publishedAt    DateTime?
  submitterId    String?
  sortOrder      Int         @default(0)
  sample         Boolean     @default(false)
  createdAt      DateTime    @default(now())

  provider Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Accounts, sessions, consent, audit
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  phone             String    @unique // E.164 (+91XXXXXXXXXX); never shown publicly
  phoneVerifiedAt   DateTime? // set by the first successful OTP sign-in
  role              Role      @default(resident)
  displayName       String?
  lang              String    @default("en") // en | hi
  localitySlug      String?
  professionalLabel String? // "Verified pharmacist": set by editors after a registration check
  email             String? // confirmed address for messages the person switches to email; never for sign-in
  emailVerifiedAt   DateTime?
  area              String? // the area they chose, finer than the locality: "Sector 57"
  reviewLabel       String? // how reviews and posts are signed: "Parent of a 2-year-old · Sector 57"
  lastSignInAt      DateTime?
  deletedAt         DateTime?
  sample            Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  locality              Locality?              @relation(fields: [localitySlug], references: [slug])
  sessions              Session[]
  savedItems            SavedItem[]
  follows               Follow[]
  consents              Consent[]
  consentStates         ConsentState[]
  reviews               Review[]               @relation("ReviewAuthor")
  reviewHelpful         ReviewHelpful[]
  reports               Report[]               @relation("ReportAuthor")
  disputes              Dispute[]              @relation("DisputeFiler")
  claims                Claim[]                @relation("ClaimAuthor")
  events                Event[]                @relation("EventSubmitter")
  threads               Thread[]               @relation("ThreadAuthor")
  posts                 Post[]                 @relation("PostAuthor")
  reactions             PostReaction[]
  societyRoles          SocietyMember[]
  volunteerApplications VolunteerApplication[]
  emailChallenges       EmailChallenge[]

  @@index([role])
}

/// One sign-in code. Only an HMAC of the code is stored (see src/lib/auth/otp.ts).
model OtpChallenge {
  id          String    @id @default(cuid())
  phone       String
  purpose     String    @default("sign_in")
  channel     String    @default("sms") // sms | whatsapp: how the code was sent
  codeHash    String
  expiresAt   DateTime
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  consumedAt  DateTime?
  ipHash      String?
  createdAt   DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([ipHash, createdAt])
}

/// A pending email address for messages: confirmed by opening a link (24 hours). Only the
/// SHA-256 of the link token is stored. Starting a new one replaces the earlier ones.
model EmailChallenge {
  id         String    @id @default(cuid())
  userId     String
  email      String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Numbers that said stop and then deleted their account: kept (hashed) for a year so they are
/// never messaged by mistake. Nothing else about the person is kept.
model StopListEntry {
  id        String   @id @default(cuid())
  phoneHash String   @unique // HMAC-SHA256(AUTH_SECRET, E.164 phone)
  reason    String // account_deleted | stop_reply
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// A signed-in browser. The cookie holds a random token; only its SHA-256 is stored.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model SavedItem {
  id        String    @id @default(cuid())
  userId    String
  kind      SavedKind
  targetId  String // provider/event/... slug, or thread id
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, targetId])
  @@index([userId, createdAt])
}

model Follow {
  id        String     @id @default(cuid())
  userId    String
  kind      FollowKind
  targetId  String // locality slug, topic slug, thread id, society slug, provider slug
  alert     AlertPref  @default(in_app)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, targetId])
  @@index([kind, targetId])
}

/// The consent record: append-only, never updated or deleted (account deletion withdraws, it
/// doesn't erase). One row per change, in the words shown on the account page.
model Consent {
  id             String          @id @default(cuid())
  userId         String
  purpose        ConsentPurpose? // null for account rows (action setting | sign_in_only)
  channel        ConsentChannel? // whatsapp | email for messages; sms | whatsapp for sign_in_only
  action         ConsentAction
  summary        String          @default("") // what, as listed: "Turned on: Locality alerts for Sohna Road"
  context        String? // where and how: "On the Sohna Road locality page. You tapped Follow and chose WhatsApp alerts."
  source         String // homepage_form | news_page | locality_page | account_settings | saved_page | whatsapp_reply | sign_in | email_link | account_deleted | admin
  wording        String // exactly what the person agreed to (grants), or what changed
  wordingVersion String
  actorId        String? // set when someone other than the user recorded it
  createdAt      DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Current consent per (user, purpose, channel), derived from the ledger.
model ConsentState {
  id            String         @id @default(cuid())
  userId        String
  purpose       ConsentPurpose
  channel       ConsentChannel
  granted       Boolean
  confirmedAt   DateTime? // double opt-in confirmation (e.g. replied YES on WhatsApp)
  lastConsentId String
  lastSentAt    DateTime? // last message of this type sent on this channel ("Last sent Fri 23 Oct")
  updatedAt     DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, purpose, channel])
}

/// Every moderator, editor and admin action. Read-only after insert.
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  actorLabel  String
  actorRole   String?
  action      String // "review.approve", "event.approve", "role.change", "private.reveal", ...
  targetKind  String?
  targetId    String?
  targetLabel String?
  reason      String?
  details     Json?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([targetKind, targetId])
  @@index([actorId])
}

/// Counters for human-readable reference codes ("HG-RV-8831"). See src/lib/refs.ts.
model Sequence {
  prefix String @id
  value  Int
}
